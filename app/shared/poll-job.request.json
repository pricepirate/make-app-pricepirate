{
  "url": "/api/v2/jobs/{{temp.jobId}}",
  "method": "GET",
  "qs": {
    "omit_partials": "true"
  },
  "repeat": {
    "condition": "{{temp.status == 'pending' && temp.polls < 48}}",
    "delay": 5000,
    "limit": 50
  },
  "response": {
    "temp": {
      "status": "{{body.status}}",
      "polls": "{{temp.polls + 1}}"
    },
    "error": {
      "$include": "shared/poll-error.json"
    }
  }
}