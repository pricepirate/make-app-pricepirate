{
  "url": "/api/v2/account",
  "method": "GET",
  "response": {
    "output": {
      "name": "{{body.name}}",
      "entitlements": "{{body.entitlements}}",
      "credits": "{{body.credits}}",
      "limits": {
        "concurrency": "{{body.limits.concurrency}}",
        "daily": {
          "{{...}}": "{{body.limits.daily}}",
          "resets_at": "{{if(body.limits.daily.resets_at; parseDate(ifempty(body.limits.daily.resets_at; '1970-01-01T00:00:00.000Z'); 'YYYY-MM-DDTHH:mm:ss.SSSZ'); null)}}"
        }
      }
    }
  }
}