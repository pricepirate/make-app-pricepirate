{
  "url": "https://api-v2.pricepirate.com/api/v2/account",
  "method": "GET",
  "headers": {
    "x-api-key": "{{parameters.apiKey}}",
    "x-pricepirate-integration": "make"
  },
  "response": {
    "metadata": {
      "type": "text",
      "value": "{{body.name}}"
    },
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.message, 'The API key was rejected.')}}"
    }
  },
  "log": {
    "sanitize": ["request.headers.x-api-key"]
  }
}
